{
  "name": "@buildcrm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" prisma/seed.ts --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "tsx watch src/worker.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" prisma/seed.ts prisma.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" prisma/seed.ts prisma.config.ts",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:unused": "knip"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.3.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "knip": "^6.42.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "29.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "type": "module"
}