# Synthetic local values only. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://buildcrm:buildcrm_local@localhost:5432/buildcrm?schema=public
# Optional in development (limits fall back to per-process memory); required in production. Needed by the worker.
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3001

# Behind a reverse proxy set the number of proxies (Caddy = 1) so client IPs are real
TRUST_PROXY_HOPS=0
# API reference pages are off in production unless set to true
ENABLE_API_DOCS=true

# Rate limits (requests per minute per client IP, per route group) and account lockout (failures per 15 minutes)
DEFAULT_RATE_LIMIT=120
LOGIN_RATE_LIMIT=5
REFRESH_RATE_LIMIT=20
ACCOUNT_LOGIN_LIMIT=10

# Required when seeding in production (never commit real values)
SEED_ADMIN_EMAIL=admin@email.com
SEED_ADMIN_PASSWORD=Admin@123123

# Docker Compose (deploy/compose/docker-compose.yml) only
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# DATABASE_URL=postgresql://buildcrm:<POSTGRES_PASSWORD>@postgres:5432/buildcrm?schema=public
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
